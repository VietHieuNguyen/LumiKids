generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DISABLED
  /// A guardian who registered and has not entered the emailed verification code yet.
  PENDING_VERIFICATION
}

enum RoleCode {
  ROLE_ADMIN
  ROLE_TEACHER
  ROLE_GUARDIAN
  ROLE_CHILD
}

enum PermissionCode {
  READ_OWN_ACCOUNT
  MANAGE_USERS
  GENERATE_GAME_CONTENT
  READ_GAME_ASSETS
  MANAGE_GAME_ASSETS
  READ_GAMES
  SAVE_GAMES
  MANAGE_ALL_GAMES
  PLAY_GAMES
  SUBMIT_OWN_INTERACTIONS
  READ_OWN_PLAY_SESSIONS
  MANAGE_CLASSROOMS
  READ_OWN_CLASSROOMS
  RESET_CHILD_LOGIN_CODES
  ASSIGN_ACTIVITIES
  MANAGE_LESSON_PLANS
  MANAGE_CLASS_INVITES
  MANAGE_FAMILY
}

enum GameAssetStatus {
  ACTIVE
  INACTIVE
}

model User {
  userId          String               @id @default(uuid()) @db.Uuid
  fullName        String
  email           String               @unique
  phone           String
  address         String
  passwordHash    String
  status          AccountStatus        @default(DISABLED)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  roles           UserRole[]
  authSessions    AuthSession[]
  gameAssets      GameAsset[]
  activities      Activity[]
  classrooms      ClassroomTeacher[]
  classGroups     ClassGroup[]
  assignments     ActivityAssignment[]
  replayDecisions ReplayRequest[]
  aiTokenUsage    AiTokenUsage[]
  teacherProfile  Teacher?
  guardianProfile Guardian?
  verification    EmailVerification?
  classInvites    ClassInvite[]
  joinDecisions   ClassJoinRequest[]
  lessonPlans     LessonPlan[]         @relation("LessonPlanCreator")
  editedPlans     LessonPlan[]         @relation("LessonPlanEditor")
}

/// Teacher profile of a User holding ROLE_TEACHER (system.md data dictionary: Teacher extends User).
model Teacher {
  userId         String @id @db.Uuid
  user           User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  specialization String @default("") @db.VarChar(200)
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  OTHER
}

/// Guardian profile of a User holding ROLE_GUARDIAN (system.md data dictionary: Guardian extends User).
model Guardian {
  userId       String               @id @db.Uuid
  user         User                 @relation(fields: [userId], references: [userId], onDelete: Cascade)
  relationship GuardianRelationship
  children     GuardianChild[]
  joinRequests ClassJoinRequest[]
  consents     SharingConsent[]
}

/// A confirmed care relationship: the guardian may manage this child's profile (BR-04).
model GuardianChild {
  guardianId String   @db.Uuid
  guardian   Guardian @relation(fields: [guardianId], references: [userId], onDelete: Cascade)
  childId    String   @db.Uuid
  child      Child    @relation(fields: [childId], references: [childId], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([guardianId, childId])
  @@index([childId])
}

/// Pending email verification of a self-registered account; only an HMAC of the code is kept.
model EmailVerification {
  userId     String   @id @db.Uuid
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  codeDigest String   @db.Char(64)
  expiresAt  DateTime @db.Timestamptz(3)
  attempts   Int      @default(0)
  sentAt     DateTime @default(now()) @db.Timestamptz(3)
}

model AiTokenUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [userId], onDelete: Restrict)
  requestId     String   @db.Uuid
  attempt       Int
  gameType      String   @db.VarChar(30)
  model         String?  @db.VarChar(100)
  status        String   @db.VarChar(60)
  inputTokens   Int?
  outputTokens  Int?
  thoughtTokens Int?
  cachedTokens  Int?
  totalTokens   Int?
  /// Wall time of the call to the AI service, for latency reporting (NFR-2).
  durationMs    Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([requestId, attempt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum Gender {
  MALE
  FEMALE
}

enum ChildStatus {
  ACTIVE
  DISABLED
}

/// A child is not a User: no email or password. Children sign in with a personal code issued by a teacher.
model Child {
  childId           String                @id @default(uuid()) @db.Uuid
  fullName          String                @db.VarChar(200)
  dob               DateTime              @db.Date
  gender            Gender
  status            ChildStatus           @default(ACTIVE)
  /// HMAC-SHA256 (hex) of the current login code; the code itself is never stored.
  loginCodeDigest   String?               @unique @db.Char(64)
  loginCodeIssuedAt DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  playSessions      PlaySession[]
  enrollments       ClassroomEnrollment[]
  authSessions      ChildAuthSession[]
  groupMemberships  ClassGroupMember[]
  assignments       ActivityRecipient[]
  guardians         GuardianChild[]
  joinRequests      ClassJoinRequest[]
  consents          SharingConsent[]
}

model SchoolYear {
  schoolYearId String      @id @default(uuid()) @db.Uuid
  name         String      @unique @db.VarChar(50)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  classrooms   Classroom[]
}

model AgeGroup {
  ageGroupId   String       @id @db.VarChar(20)
  name         String       @unique @db.VarChar(50)
  minAge       Int
  maxAge       Int
  displayOrder Int
  classrooms   Classroom[]
  activities   Activity[]
  lessonPlans  LessonPlan[]
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

model Classroom {
  classId      String                @id @default(uuid()) @db.Uuid
  className    String                @db.VarChar(100)
  schoolYearId String                @db.Uuid
  schoolYear   SchoolYear            @relation(fields: [schoolYearId], references: [schoolYearId], onDelete: Restrict)
  ageGroupId   String                @db.VarChar(20)
  ageGroup     AgeGroup              @relation(fields: [ageGroupId], references: [ageGroupId], onDelete: Restrict)
  status       ClassroomStatus       @default(ACTIVE)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)
  teachers     ClassroomTeacher[]
  enrollments  ClassroomEnrollment[]
  groups       ClassGroup[]
  assignments  ActivityAssignment[]
  invites      ClassInvite[]
  joinRequests ClassJoinRequest[]
  consents     SharingConsent[]

  @@unique([schoolYearId, className])
  @@index([status])
}

model ClassroomTeacher {
  classId   String    @db.Uuid
  classroom Classroom @relation(fields: [classId], references: [classId], onDelete: Cascade)
  userId    String    @db.Uuid
  teacher   User      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  addedAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@id([classId, userId])
  @@index([userId])
}

/// Membership history. endedAt null = current class; the migration adds a partial unique index so a child
/// has at most one open enrollment.
model ClassroomEnrollment {
  enrollmentId String          @id @default(uuid()) @db.Uuid
  classId      String          @db.Uuid
  classroom    Classroom       @relation(fields: [classId], references: [classId], onDelete: Restrict)
  childId      String          @db.Uuid
  child        Child           @relation(fields: [childId], references: [childId], onDelete: Restrict)
  startedAt    DateTime        @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?       @db.Timestamptz(3)
  /// Set when the child joined through a guardian's request (family-linked enrollment).
  consent      SharingConsent?

  @@index([childId, startedAt])
  @@index([classId, endedAt])
}

enum PlaySessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InteractionEventType {
  SELECT_CHOICE
  MATCH_DROP
  CLASSIFY_DROP
  REQUEST_HINT
  FILL_PATTERN
}

enum InteractionResult {
  CORRECT
  INCORRECT
}

model PlaySession {
  sessionId      String               @id @default(uuid()) @db.Uuid
  childId        String               @db.Uuid
  child          Child                @relation(fields: [childId], references: [childId], onDelete: Restrict)
  versionId      String               @db.Uuid
  version        ActivityVersion      @relation(fields: [versionId], references: [versionId], onDelete: Restrict)
  status         PlaySessionStatus    @default(IN_PROGRESS)
  startRequestId String               @db.Uuid
  eventCount     Int                  @default(0)
  startedAt      DateTime             @default(now()) @db.Timestamptz(3)
  endedAt        DateTime?            @db.Timestamptz(3)
  lastEventAt    DateTime?            @db.Timestamptz(3)
  /// SessionPerformance value object, written once when the session completes.
  performance    Json?                @db.JsonB
  interactions   InteractionEvent[]
  evaluation     CriterionEvaluation?

  @@unique([childId, startRequestId])
  @@index([childId, startedAt])
  @@index([childId, status])
  @@index([versionId])
}

model InteractionEvent {
  eventId         String               @id @db.Uuid
  sessionId       String               @db.Uuid
  session         PlaySession          @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  eventType       InteractionEventType
  actionData      Json                 @db.JsonB
  /// Null for a hint request (it is not an answer).
  result          InteractionResult?
  attemptIndex    Int
  schemaVersion   Int
  clientTimestamp DateTime             @db.Timestamptz(3)
  receivedAt      DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, attemptIndex])
}

enum CriterionLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
}

/// Result of one completed PlaySession for the version's single criterion. Score only for now;
/// level and summary are filled by the later assessment/AI phase.
model CriterionEvaluation {
  criterionEvaluationId String              @id @default(uuid()) @db.Uuid
  sessionId             String              @unique @db.Uuid
  session               PlaySession         @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  criterionCode         String              @db.VarChar(20)
  criterion             AssessmentCriterion @relation(fields: [criterionCode], references: [criterionCode], onDelete: Restrict)
  /// Unrounded percentage 0–100; null when the version has no scored item.
  score                 Float?
  level                 CriterionLevel?
  summary               String?
  minimumItemsMet       Boolean
  ruleVersion           String              @db.VarChar(40)
  evaluatedAt           DateTime            @default(now()) @db.Timestamptz(3)

  @@index([criterionCode])
}

enum ActivityStatus {
  ACTIVE
  ARCHIVED
}

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
}

enum GameType {
  COUNTING
  MATCHING
  CLASSIFICATION
  PATTERN
}

enum CompletionRule {
  CORRECT_CHOICE
  ALL_PAIRS_CORRECT
  ALL_ITEMS_CLASSIFIED_CORRECTLY
  ALL_SEQUENCES_COMPLETED
}

model Skill {
  skillCode    String                @id @db.VarChar(20)
  name         String                @db.VarChar(200)
  description  String
  displayOrder Int
  criterions   AssessmentCriterion[]
  lessonPlans  LessonPlan[]
}

model AssessmentCriterion {
  criterionCode String                     @id @db.VarChar(20)
  description   String
  skillCode     String                     @db.VarChar(20)
  displayOrder  Int
  skill         Skill                      @relation(fields: [skillCode], references: [skillCode], onDelete: Restrict)
  versions      ActivityVersionCriterion[]
  evaluations   CriterionEvaluation[]

  @@index([skillCode, displayOrder])
}

model Activity {
  activityId      String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(200)
  description     String            @default("") @db.VarChar(1000)
  createdBy       String            @db.Uuid
  creator         User              @relation(fields: [createdBy], references: [userId], onDelete: Restrict)
  status          ActivityStatus    @default(ACTIVE)
  /// Target age group (FR-5.1 AC-01); null only for games saved before age groups were required.
  ageGroupId      String?           @db.VarChar(20)
  ageGroup        AgeGroup?         @relation(fields: [ageGroupId], references: [ageGroupId], onDelete: Restrict)
  saveRequestId   String            @db.Uuid
  saveFingerprint String            @db.Char(64)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  versions        ActivityVersion[]

  @@unique([createdBy, saveRequestId])
  @@index([status, createdAt, activityId])
  @@index([createdBy, status])
}

model ActivityVersion {
  versionId      String                     @id @default(uuid()) @db.Uuid
  activityId     String                     @db.Uuid
  activity       Activity                   @relation(fields: [activityId], references: [activityId], onDelete: Restrict)
  versionNumber  Int
  instruction    String
  difficulty     GameDifficulty
  gameType       GameType
  content        Json                       @db.JsonB
  completionRule CompletionRule
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  criterions     ActivityVersionCriterion[]
  playSessions   PlaySession[]
  assignments    ActivityAssignmentItem[]
  lessonBlocks   LessonBlock[]

  @@unique([activityId, versionNumber])
  @@index([gameType, difficulty])
}

model ActivityVersionCriterion {
  versionId     String              @db.Uuid
  criterionCode String              @db.VarChar(20)
  version       ActivityVersion     @relation(fields: [versionId], references: [versionId], onDelete: Restrict)
  criterion     AssessmentCriterion @relation(fields: [criterionCode], references: [criterionCode], onDelete: Restrict)

  @@id([versionId, criterionCode])
  @@index([criterionCode])
}

model GameAsset {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @db.VarChar(200)
  objectKey        String          @unique @db.VarChar(200)
  originalFileName String          @db.VarChar(255)
  mimeType         String          @db.VarChar(30)
  sizeBytes        Int
  objectType       String          @db.VarChar(40)
  tags             String[]        @default([])
  attributes       Json            @default("{}") @db.JsonB
  status           GameAssetStatus @default(ACTIVE)
  createdBy        String?         @db.Uuid
  creator          User?           @relation(fields: [createdBy], references: [userId], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, objectType, createdAt, id])
  @@index([tags], type: Gin)
  @@index([createdBy])
}

model Role {
  roleId      String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  permissionId String           @id @default(uuid()) @db.Uuid
  code         PermissionCode   @unique
  roles        RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  sessionId String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt DateTime       @db.Timestamptz(3)
  revokedAt DateTime?      @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tokens    RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

/// Sign-in sessions of children; separate from AuthSession because a child is not a User.
model ChildAuthSession {
  sessionId String              @id @default(uuid()) @db.Uuid
  childId   String              @db.Uuid
  child     Child               @relation(fields: [childId], references: [childId], onDelete: Cascade)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  expiresAt DateTime            @db.Timestamptz(3)
  revokedAt DateTime?           @db.Timestamptz(3)
  tokens    ChildRefreshToken[]

  @@index([childId])
  @@index([expiresAt])
}

model ChildRefreshToken {
  tokenId   String           @id @db.Uuid
  sessionId String           @db.Uuid
  verifier  String           @db.Char(64)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  session   ChildAuthSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model RefreshToken {
  tokenId   String      @id @db.Uuid
  sessionId String      @db.Uuid
  verifier  String      @db.Char(64)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt DateTime    @db.Timestamptz(3)
  usedAt    DateTime?   @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

enum AssignmentTargetType {
  CLASS
  GROUP
  CHILDREN
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum AssignmentSource {
  TEACHER
  GUARDIAN
}

enum ReplayRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A fixed group of children inside one class, made by its teachers (e.g. from results) to assign games to.
model ClassGroup {
  groupId   String             @id @default(uuid()) @db.Uuid
  classId   String             @db.Uuid
  classroom Classroom          @relation(fields: [classId], references: [classId], onDelete: Cascade)
  name      String             @db.VarChar(100)
  createdBy String             @db.Uuid
  creator   User               @relation(fields: [createdBy], references: [userId], onDelete: Restrict)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)
  members   ClassGroupMember[]

  @@unique([classId, name])
}

model ClassGroupMember {
  groupId String     @db.Uuid
  group   ClassGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  childId String     @db.Uuid
  child   Child      @relation(fields: [childId], references: [childId], onDelete: Cascade)
  addedAt DateTime   @default(now()) @db.Timestamptz(3)

  @@id([groupId, childId])
  @@index([childId])
}

/// A teacher hands a class (or a group, or picked children) a set of game versions to play.
model ActivityAssignment {
  assignmentId String                   @id @default(uuid()) @db.Uuid
  /// TEACHER: a class assignment. GUARDIAN: a family pick for the guardian's own child (no class).
  source       AssignmentSource         @default(TEACHER)
  classId      String?                  @db.Uuid
  classroom    Classroom?               @relation(fields: [classId], references: [classId], onDelete: Restrict)
  title        String                   @db.VarChar(200)
  note         String                   @default("") @db.VarChar(1000)
  createdBy    String                   @db.Uuid
  creator      User                     @relation(fields: [createdBy], references: [userId], onDelete: Restrict)
  /// Children see the assignment from this instant.
  opensAt      DateTime                 @db.Timestamptz(3)
  /// Optional deadline; after it only children with an extension may still start a game.
  dueAt        DateTime?                @db.Timestamptz(3)
  targetType   AssignmentTargetType
  /// Name of the group or "N trẻ" at assignment time; recipients are a snapshot.
  targetLabel  String                   @db.VarChar(120)
  status       AssignmentStatus         @default(ACTIVE)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)
  items        ActivityAssignmentItem[]
  recipients   ActivityRecipient[]

  @@index([classId, opensAt])
  @@index([source, createdBy])
}

model ActivityAssignmentItem {
  assignmentId String             @db.Uuid
  assignment   ActivityAssignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)
  versionId    String             @db.Uuid
  version      ActivityVersion    @relation(fields: [versionId], references: [versionId], onDelete: Restrict)
  position     Int

  @@id([assignmentId, versionId])
  @@unique([assignmentId, position])
  @@index([versionId])
}

/// One child receiving an assignment. Completion is derived from COMPLETED play sessions, never stored.
model ActivityRecipient {
  recipientId    String             @id @default(uuid()) @db.Uuid
  assignmentId   String             @db.Uuid
  assignment     ActivityAssignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)
  childId        String             @db.Uuid
  child          Child              @relation(fields: [childId], references: [childId], onDelete: Restrict)
  /// Set by an approved replay request or a teacher extension: the child may play until then.
  extendedUntil  DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  replayRequests ReplayRequest[]

  @@unique([assignmentId, childId])
  @@index([childId])
}

/// A child asks to play an assignment again after its deadline; a teacher approves (new deadline) or rejects.
model ReplayRequest {
  requestId    String              @id @default(uuid()) @db.Uuid
  recipientId  String              @db.Uuid
  recipient    ActivityRecipient   @relation(fields: [recipientId], references: [recipientId], onDelete: Cascade)
  status       ReplayRequestStatus @default(PENDING)
  requestedAt  DateTime            @default(now()) @db.Timestamptz(3)
  decidedAt    DateTime?           @db.Timestamptz(3)
  decidedBy    String?             @db.Uuid
  decider      User?               @relation(fields: [decidedBy], references: [userId], onDelete: Restrict)
  grantedUntil DateTime?           @db.Timestamptz(3)

  @@index([recipientId, status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A teacher's invitation link to a class (FR-1.8, BR-14). Only an HMAC of the secret code is stored.
model ClassInvite {
  inviteId     String             @id @default(uuid()) @db.Uuid
  classId      String             @db.Uuid
  classroom    Classroom          @relation(fields: [classId], references: [classId], onDelete: Restrict)
  codeDigest   String             @unique @db.Char(64)
  createdBy    String             @db.Uuid
  creator      User               @relation(fields: [createdBy], references: [userId], onDelete: Restrict)
  expiresAt    DateTime           @db.Timestamptz(3)
  maxUses      Int
  useCount     Int                @default(0)
  revokedAt    DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  joinRequests ClassJoinRequest[]

  @@index([classId, createdAt])
}

/// A guardian asks for their child to join a class; the consent they confirmed is stored with it (BR-15).
model ClassJoinRequest {
  requestId      String            @id @default(uuid()) @db.Uuid
  inviteId       String            @db.Uuid
  invite         ClassInvite       @relation(fields: [inviteId], references: [inviteId], onDelete: Restrict)
  classId        String            @db.Uuid
  classroom      Classroom         @relation(fields: [classId], references: [classId], onDelete: Restrict)
  childId        String            @db.Uuid
  child          Child             @relation(fields: [childId], references: [childId], onDelete: Cascade)
  guardianId     String            @db.Uuid
  guardian       Guardian          @relation(fields: [guardianId], references: [userId], onDelete: Cascade)
  status         JoinRequestStatus @default(PENDING)
  consentVersion String            @db.VarChar(40)
  consentScope   String[]
  consentedAt    DateTime          @db.Timestamptz(3)
  requestedAt    DateTime          @default(now()) @db.Timestamptz(3)
  decidedAt      DateTime?         @db.Timestamptz(3)
  decidedBy      String?           @db.Uuid
  decider        User?             @relation(fields: [decidedBy], references: [userId], onDelete: Restrict)
  consent        SharingConsent?

  @@index([classId, status])
  @@index([guardianId, requestedAt])
}

/// Consent behind a family-linked enrollment. Revoking it ends the enrollment and the teacher's access (BR-15/16).
model SharingConsent {
  consentId    String              @id @default(uuid()) @db.Uuid
  requestId    String              @unique @db.Uuid
  request      ClassJoinRequest    @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  enrollmentId String              @unique @db.Uuid
  enrollment   ClassroomEnrollment @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Restrict)
  childId      String              @db.Uuid
  child        Child               @relation(fields: [childId], references: [childId], onDelete: Cascade)
  guardianId   String              @db.Uuid
  guardian     Guardian            @relation(fields: [guardianId], references: [userId], onDelete: Cascade)
  classId      String              @db.Uuid
  classroom    Classroom           @relation(fields: [classId], references: [classId], onDelete: Restrict)
  version      String              @db.VarChar(40)
  scope        String[]
  grantedAt    DateTime            @db.Timestamptz(3)
  revokedAt    DateTime?           @db.Timestamptz(3)

  @@index([childId])
}

enum LessonPlanStatus {
  DRAFT
  COMPLETE
}

/// A teacher's lesson plan (UC-AI-02, manual part): four sections, the progression as ordered blocks.
model LessonPlan {
  lessonPlanId       String           @id @default(uuid()) @db.Uuid
  title              String           @db.VarChar(200)
  topic              String           @default("") @db.VarChar(200)
  ageGroupId         String?          @db.VarChar(20)
  ageGroup           AgeGroup?        @relation(fields: [ageGroupId], references: [ageGroupId], onDelete: Restrict)
  skillCode          String?          @db.VarChar(20)
  skill              Skill?           @relation(fields: [skillCode], references: [skillCode], onDelete: Restrict)
  durationMinutes    Int?
  objectives         String           @default("")
  preparation        String           @default("")
  evaluation         String           @default("")
  status             LessonPlanStatus @default(DRAFT)
  /// Incremented on every save; a save naming an older revision is a conflict (UC-AI-02 AC-04).
  revision           Int              @default(1)
  createdBy          String           @db.Uuid
  creator            User             @relation("LessonPlanCreator", fields: [createdBy], references: [userId], onDelete: Restrict)
  updatedBy          String           @db.Uuid
  editor             User             @relation("LessonPlanEditor", fields: [updatedBy], references: [userId], onDelete: Restrict)
  sourceLessonPlanId String?          @db.Uuid
  source             LessonPlan?      @relation("LessonPlanCopies", fields: [sourceLessonPlanId], references: [lessonPlanId], onDelete: SetNull)
  copies             LessonPlan[]     @relation("LessonPlanCopies")
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  blocks             LessonBlock[]

  @@index([createdBy, updatedAt])
}

/// One step of the progression; may link one saved game version.
model LessonBlock {
  blockId         String           @id @default(uuid()) @db.Uuid
  lessonPlanId    String           @db.Uuid
  lessonPlan      LessonPlan       @relation(fields: [lessonPlanId], references: [lessonPlanId], onDelete: Cascade)
  position        Int
  title           String           @db.VarChar(200)
  instruction     String           @default("")
  durationMinutes Int?
  versionId       String?          @db.Uuid
  version         ActivityVersion? @relation(fields: [versionId], references: [versionId], onDelete: Restrict)

  @@unique([lessonPlanId, position])
  @@index([versionId])
}

/// Site-wide branding, a single row (id = 1, enforced by a CHECK). The logo file lives in object
/// storage under logoObjectKey and is served by the API; landingScene names a 3D scene the web knows.
model SiteSetting {
  id            Int      @id @default(1)
  siteName      String   @default("LumiKids") @db.VarChar(60)
  tagline       String?  @db.VarChar(160)
  logoObjectKey String?  @db.VarChar(255)
  logoMimeType  String?  @db.VarChar(50)
  landingScene  String   @default("VALLEY") @db.VarChar(30)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}
