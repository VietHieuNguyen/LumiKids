PORT=4000
# Required at runtime. Keep the real PostgreSQL URL in .env.development.
DATABASE_URL=

# Required: supply a random secret with at least 32 characters locally.
JWT_ACCESS_SECRET=
JWT_ISSUER=lumikids-api
JWT_AUDIENCE=lumikids-web
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# Required for GameAsset. Use a bucket-scoped application user/key, never MinIO root.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lumikids-game-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_READ_URL_TTL_SECONDS=900
GAME_ASSET_MAX_SIZE_BYTES=5242880

# Optional until using game generation; Gemini key belongs ONLY to services/ai.
AI_SERVICE_URL=
# Same random secret (at least 32 characters) as services/ai AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=25000
