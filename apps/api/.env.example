PORT=4000
# Required at runtime. Keep the real PostgreSQL URL in .env.development.
DATABASE_URL=

# Required: supply a random secret with at least 32 characters locally.
JWT_ACCESS_SECRET=
JWT_ISSUER=lumikids-api
JWT_AUDIENCE=lumikids-web
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000
# Child sign-in with a login code. Optional: without CHILD_LOGIN_CODE_SECRET (32+ chars) a key is derived from
# JWT_ACCESS_SECRET, and rotating that secret then invalidates every child's code. Default refresh: 12 hours.
CHILD_LOGIN_CODE_SECRET=
CHILD_REFRESH_TTL_SECONDS=43200

# Required for GameAsset. Use a bucket-scoped application user/key, never MinIO root.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lumikids-game-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_READ_URL_TTL_SECONDS=900
GAME_ASSET_MAX_SIZE_BYTES=5242880

# Optional until using game generation; Gemini key belongs ONLY to services/ai.
AI_SERVICE_URL=
# Same random secret (at least 32 characters) as services/ai AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=25000

# Outgoing mail for guardian email verification (Gmail SMTP by default).
# EMAIL_PASSWORD is a Gmail App Password (Google Account > Security > App passwords), not the account password.
# Mail stays off until EMAIL_USER and EMAIL_PASSWORD are both set; outside production codes are also logged.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Web origin for the button in emails (defaults to the first AUTH_ALLOWED_ORIGINS entry).
EMAIL_LINK_BASE_URL=
