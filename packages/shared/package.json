{
  "name": "@lumikids/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:types": "tsc -p tests/tsconfig.json",
    "test": "pnpm build && pnpm test:types && node --test tests/game-content.test.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
