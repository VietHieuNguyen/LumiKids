{
  "info": {
    "name": "LumiKids GameAsset",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual integration only. Configure S3 app credentials and apply reviewed migrations first. Uses real PostgreSQL/MinIO; Upload and PATCH change data. No deletes. Select a local image for Upload; email/password/token are blank."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "assetId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Admin (saves accessToken)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Protection",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload asset (select local file)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/game-assets",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            },
            {
              "key": "name",
              "type": "text",
              "value": "Qu? b?ng m?u ??"
            },
            {
              "key": "objectType",
              "type": "text",
              "value": "BALL"
            },
            {
              "key": "tags",
              "type": "text",
              "value": "[\"ball\",\"red\",\"toy\"]"
            },
            {
              "key": "attributes",
              "type": "text",
              "value": "{\"color\":\"RED\",\"shape\":\"CIRCLE\"}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set('assetId', pm.response.json().data.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "List ACTIVE assets (edit optional Params)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/game-assets?page=1&pageSize=20&status=ACTIVE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "game-assets"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            },
            {
              "key": "status",
              "value": "ACTIVE"
            },
            {
              "key": "search",
              "value": "b?ng",
              "disabled": true
            },
            {
              "key": "objectType",
              "value": "BALL",
              "disabled": true
            },
            {
              "key": "tags",
              "value": "[\"red\"]",
              "disabled": true
            },
            {
              "key": "attributes",
              "value": "{\"color\":\"RED\"}",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Asset detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/game-assets/{{assetId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update metadata (file unchanged)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/game-assets/{{assetId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Qu? b?ng xanh\",\n  \"tags\": [\n    \"ball\",\n    \"blue\"\n  ],\n  \"attributes\": {\n    \"color\": \"BLUE\",\n    \"shape\": \"CIRCLE\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get temporary read URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/game-assets/{{assetId}}/url",
        "description": "Copy data.url unchanged into a browser. It is not stored in collection variables or the database. Bucket remains private."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate (file retained)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/game-assets/{{assetId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reactivate",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/game-assets/{{assetId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
